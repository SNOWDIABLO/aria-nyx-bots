# ============================================================
# Copie ce fichier en .env et remplis tes valeurs
# ============================================================

# --- Bot 1 ---
BOT1_TOKEN=ton_token_bot1_ici
BOT1_NAME=Aria

# --- Bot 2 ---
BOT2_TOKEN=ton_token_bot2_ici
BOT2_NAME=Nyx

# --- API IA (OpenRouter = meilleur rapport qualité/prix + modèles non-filtrés) ---
# Inscription gratuite sur https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxx

# Ou bien OpenAI classique :
# OPENAI_API_KEY=sk-xxxxxxxxxxxx

# --- Config Discord ---
# L'ID du salon où les bots peuvent discuter librement (clic droit sur salon > Copier l'ID)
CHAT_CHANNEL_ID=123456789012345678

# L'ID de ton serveur Discord
GUILD_ID=123456789012345678

# --- Comportement ---
# Nombre de messages max dans un échange autonome avant pause
MAX_EXCHANGE_MESSAGES=8

# Délai entre les messages des bots (en ms) pour paraître naturel
BOT_REPLY_DELAY_MIN=3000
BOT_REPLY_DELAY_MAX=8000

# Modèle IA à utiliser
# Recommandés pour OpenRouter : "meta-llama/llama-3.1-8b-instruct:free" (gratuit)
# Ou : "nousresearch/hermes-3-llama-3.1-405b" (plus puissant, payant)
# Ou : "openai/gpt-4o-mini" (OpenAI classique)
AI_MODEL=meta-llama/llama-3.1-8b-instruct:free
